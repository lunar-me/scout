{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "ES2024.Promise"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "types": [
      "bun"
    ]
  }
}
